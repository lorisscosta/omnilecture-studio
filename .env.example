# ==============================================================================
# OmniLecture Studio - Configurazione Ambiente (.env.example)
# Copia questo file in .env.local e inserisci i tuoi valori reali.
# NON committare mai file .env contenenti chiavi reali o segreti.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database PostgreSQL, Autenticazione & RLS)
# ------------------------------------------------------------------------------
# URL del tuo progetto Supabase (reperibile nella Dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://tuo-progetto.supabase.co"

# Chiave anonima pubblica di Supabase (safe per il client browser, protetta da RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="tuo-anon-key-qui"

# [Opzionale / Backend] Chiave Service Role di Supabase (per operazioni di manutenzione server-side)
# ATTENZIONE: Non esporre mai questa chiave con prefisso NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY="tuo-service-role-key-qui"

# ------------------------------------------------------------------------------
# 2. Google Gemini / Google AI Studio (Fallback Server-Side)
# ------------------------------------------------------------------------------
# Chiave API Google AI Studio usata dal server proxy (/api/gemini/process-audio e /api/gemini/chat)
# come fallback quando l'utente non ha inserito la propria chiave personale BYOK nel client.
# Ottieni la chiave gratuita su: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 3. Rate Limiting Proxy Serverless (Protezione Abusi & Quota)
# ------------------------------------------------------------------------------
# Numero massimo di richieste orarie consentite per singolo utente autenticato sul proxy server
GEMINI_PROXY_HOURLY_LIMIT=15

# Numero massimo di richieste giornaliere consentite per singolo utente autenticato sul proxy server
GEMINI_PROXY_DAILY_LIMIT=50
